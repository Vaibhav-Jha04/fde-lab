# Copy to .env and fill in. .env is never committed.
CLINIC_API_KEY=            # any long random string; Bland sends it as the X-Clinic-Key header
BLAND_WEBHOOK_SECRET=      # Bland dev portal > Account settings > Keys > webhook signing secret
BLAND_API_KEY=             # Bland dashboard API key (org_...)
NEBIUS_API_KEY=            # tokenfactory.nebius.com API key
CLINIC_DB=clinic.db
CLINIC_TZ=America/New_York
